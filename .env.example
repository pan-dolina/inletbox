# ---------------------------------------------------------------------------
# inletbox configuration (copy to .env). No secrets are included here.
# Sizes accept plain bytes or suffixes: 100MB, 2GB, 512KiB (MB = MiB here).
# ---------------------------------------------------------------------------

# Public base URL of this instance, as seen by clients. Used to build upload
# links and curl commands. Must include scheme. No trailing slash.
PUBLIC_URL=http://localhost:3000

# Listen address.
HOST=0.0.0.0
PORT=3000

# Set to "true" (or a hop count, e.g. 1) when running behind a reverse proxy
# so that client IPs are read from X-Forwarded-For for rate limiting/audit.
TRUST_PROXY=false

# Where the SQLite database (and, for the local backend, files) live.
DATA_DIR=./data

# ---- Storage -------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
# Local backend: directory for file objects (defaults to $DATA_DIR/files).
# Keep it outside any web-served directory.
#LOCAL_STORAGE_DIR=./data/files

# S3 / S3-compatible backend (MinIO, Ceph RGW, ...). The bucket must be private.
#S3_ENDPOINT=http://minio:9000
#S3_REGION=us-east-1
#S3_BUCKET=inletbox
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
# Required for MinIO and most self-hosted S3 implementations.
#S3_FORCE_PATH_STYLE=true
# Multipart part size for resumable uploads (min 5MB).
#S3_PART_SIZE=8MB

# ---- Limits ---------------------------------------------------------------
# Global maximum size of a single file. Per-link limits can only lower this.
MAX_FILE_SIZE=10GB
# Browser upload chunk size (tus PATCH request size). Larger = fewer requests,
# smaller = finer-grained resume. Must be below any reverse proxy body limit.
UPLOAD_CHUNK_SIZE=32MB

# ---- Housekeeping -----------------------------------------------------------
# Unfinished uploads older than this are deleted (storage + metadata).
INCOMPLETE_UPLOAD_TTL_HOURS=24
# How often the cleanup job runs inside the app process. 0 disables it.
CLEANUP_INTERVAL_MINUTES=30

# ---- Admin sessions ---------------------------------------------------------
SESSION_TTL_HOURS=12
# Require every admin to enrol a TOTP authenticator app before using the panel.
# Recommended for internet-facing instances. Admins can also enable it themselves.
ADMIN_REQUIRE_TOTP=false
# Defaults to true when PUBLIC_URL starts with https://. Set to false only for
# plain-HTTP local development.
#COOKIE_SECURE=true

# ---- Rate limiting (per client IP) ----------------------------------------
LOGIN_RATE_LIMIT_PER_15MIN=10
# Failed token lookups (invalid/expired links) per IP per 15 minutes.
TOKEN_FAILURE_RATE_LIMIT_PER_15MIN=30
# General public API requests per IP per minute (upload chunks included).
PUBLIC_RATE_LIMIT_PER_MINUTE=600

# debug | info | warn | error
LOG_LEVEL=info
